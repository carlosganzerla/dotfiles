[merge]
	tool = nvimdiff
	conflictStyle = zdiff3
[core]
	editor = nvim
	pager = less
[pull]
	ff = only
[rerere]
	enabled = true
[alias]
    topiclog = log --oneline --left-right devel...HEAD
    graphlog = log --graph --topo-order --pretty='%w(100,0,6)%C(yellow)%h%C(bold)%C(black)%d %C(cyan)%ar %C(green)%an%n%C(bold)%C(white)%s %N' --abbrev-commit
    sync-master = !git checkout master && git pull && git rebase devel && git push && git checkout devel
    devel = !git checkout devel && git pull && git remote prune origin && git prune
	rescue = !git fsck --full --no-reflogs --unreachable --lost-found | grep commit | cut -d\\  -f3 | xargs -n 1 git log -n 1 --pretty=oneline > .git/lost-found.txt
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[advice]
    skippedCherryPicks = false
[diff]
	algorithm = histogram
